# Database
MONGODB_URI=mongodb://localhost:27017/openai-workflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM Provider Selection
# Options: "opencode-cli" (default), "ollama"
LLM_PROVIDER=opencode-cli

# Ollama (for LLM and embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=dolphin-mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenCode CLI
OPENCODE_MODEL=opencode/mimo-v2-pro-free

# OpenAI (fallback for embeddings)
OPENAI_API_KEY=sk-your-openai-key

# AsuraScans Credentials
ASURA_EMAIL=your@email.com
ASURA_PASSWORD=yourpassword

# TikTok Crawler
TIKTOK_ACCOUNT=
CHROME_PORT=9222

# Development
USE_MOCK=false
NODE_ENV=development
